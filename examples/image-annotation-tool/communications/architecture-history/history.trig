      schema:position "13"^^xsd:integer ;
      c4:source :export-approved ;
      c4:target :build-coco ;
      rdfs:label "build_coco(rows)" .
  :step:export:export-approved:minio a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "14"^^xsd:integer ;
      c4:source :export-approved ;
      c4:target :minio ;
      rdfs:label "PUT exports/export-<id>.coco.json" .
  :step:export:export-approved:postgres:3 a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "15"^^xsd:integer ;
      c4:source :export-approved ;
      c4:target :postgres ;
      rdfs:label "UPDATE exports: done, key, task_count" .
  :step:export:admin-page:client:2 a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "16"^^xsd:integer ;
      c4:source :admin-page ;
      c4:target :client ;
      rdfs:label "getExport(id) every 2 s" .
  :step:export:client:get-export a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "17"^^xsd:integer ;
      c4:source :client ;
      c4:target :get-export ;
      rdfs:label "GET /api/exports/{id}" .
  :step:export:get-export:export-to-dict a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "18"^^xsd:integer ;
      c4:source :get-export ;
      c4:target :export-to-dict ;
      rdfs:label "export_to_dict(export)" .
  :step:export:export-to-dict:presigned-url a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "19"^^xsd:integer ;
      c4:source :export-to-dict ;
      c4:target :presigned-url ;
      rdfs:label "sign exports/<storage_key>" .
  :step:export:get-export:client a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "20"^^xsd:integer ;
      c4:source :get-export ;
      c4:target :client ;
      rdfs:label "200 · done + download_url" ;
      c4:isReply "true"^^xsd:boolean .
  :step:export:admin:admin-page:2 a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "21"^^xsd:integer ;
      c4:source :admin ;
      c4:target :admin-page ;
      rdfs:label "clicks Download COCO JSON" .
  :step:export:admin-page:minio a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "22"^^xsd:integer ;
      c4:source :admin-page ;
      c4:target :minio ;
      rdfs:label "GET export file (presigned URL)" .
}
