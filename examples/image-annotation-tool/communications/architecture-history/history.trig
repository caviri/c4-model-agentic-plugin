GRAPH :version:888fcadf3564b60bd485b6b74af2a8da5b92dcc9 {
  :model:image-annotation-tool a c4:Model ;
      dcterms:title "Image Annotation Tool architecture" ;
      rdfs:label "Image Annotation Tool" ;
      dcterms:description "Humans draw labelled bounding boxes on images; every task is reviewed before it can be exported as COCO JSON. Start at the API service, then open \"Task lifecycle\" to see the statuses a task moves through. The Dynamic tab walks through upload, annotate, review and export." ;
      dcterms:identifier "image-annotation-tool" ;
      dcterms:conformsTo <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4>, <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view> ;
      c4v:subtitle "examples/image-annotation-tool" ;
      c4v:toolbarTitle "Architecture map" ;
      c4v:startLevel "2"^^xsd:integer ;
      c4v:defaultPins :list:model:image-annotation-tool:defaultPins:1 ;
      dcterms:hasPart :admin, :annotator, :reviewer, :iat .
  :list:model:image-annotation-tool:defaultPins:1 rdf:first :annotator ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:2 .
  :list:model:image-annotation-tool:defaultPins:2 rdf:first :reviewer ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:3 .
  :list:model:image-annotation-tool:defaultPins:3 rdf:first :web ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:4 .
  :list:model:image-annotation-tool:defaultPins:4 rdf:first :apply-action ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:5 .
  :list:model:image-annotation-tool:defaultPins:5 rdf:first :next-status ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:6 .
  :list:model:image-annotation-tool:defaultPins:6 rdf:first :queue ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:7 .
  :list:model:image-annotation-tool:defaultPins:7 rdf:first :postgres ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:8 .
  :list:model:image-annotation-tool:defaultPins:8 rdf:first :redis ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:9 .
  :list:model:image-annotation-tool:defaultPins:9 rdf:first :worker ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:10 .
  :list:model:image-annotation-tool:defaultPins:10 rdf:first :minio ;
      rdf:rest rdf:nil .
  :admin a c4:Element, c4:Person ;
      rdfs:label "Admin" ;
      dcterms:identifier "admin" ;
      dcterms:description "Uploads batches of images and triggers exports of approved annotations. Role \"admin\" in the users table." ;
      c4:summary "uploads batches · exports" ;
      c4:level "1"^^xsd:integer ;
      c4:path "README.md" ;
      c4:line "14"^^xsd:integer ;
      dcterms:isPartOf :model:image-annotation-tool ;
      c4v:order "1"^^xsd:integer ;
      c4v:column "2"^^xsd:integer ;
      c4v:row "0"^^xsd:integer ;
      c4:uses :admin-page .
  :annotator a c4:Element, c4:Person ;
      rdfs:label "Annotator" ;
      dcterms:identifier "annotator" ;
      dcterms:description "Claims a task, draws and labels bounding boxes on the image, submits it for review, and fixes rejected tasks." ;
      c4:summary "draws + labels boxes" ;
      c4:level "1"^^xsd:integer ;
      c4:path "README.md" ;
      c4:line "15"^^xsd:integer ;
      dcterms:isPartOf :model:image-annotation-tool ;
      c4v:order "2"^^xsd:integer ;
      c4v:column "0"^^xsd:integer ;
      c4v:row "0"^^xsd:integer ;
      c4:uses :annotate-page .
  :reviewer a c4:Element, c4:Person ;
      rdfs:label "Reviewer" ;
      dcterms:identifier "reviewer" ;
      dcterms:description "Works through the review queue and approves each submitted task or rejects it with a mandatory comment." ;
      c4:summary "approves or rejects" ;
      c4:level "1"^^xsd:integer ;
      c4:path "README.md" ;
      c4:line "16"^^xsd:integer ;
      dcterms:isPartOf :model:image-annotation-tool ;
      c4v:order "3"^^xsd:integer ;
      c4v:column "1"^^xsd:integer ;
      c4v:row "0"^^xsd:integer ;
      c4:uses :review-page .
  :iat a c4:Element, c4:SoftwareSystem ;
      rdfs:label "Image Annotation Tool" ;
      dcterms:identifier "iat" ;
      dcterms:description "Bounding-box annotation with a review step. Each uploaded image gets exactly one task; only approved tasks are exported as COCO-style JSON." ;
      c4:summary "annotate · review · export" ;
      c4:level "1"^^xsd:integer ;
      c4:note "Everything runs from one docker-compose.yml; there are no external systems. PostgreSQL, Redis and MinIO come from public images.", "Theoretical example project: a documentation fixture that has never been executed." ;
      c4v:noteList :list:iat:noteList:1 ;
      c4:path "." ;
      dcterms:isPartOf :model:image-annotation-tool ;
      c4v:order "4"^^xsd:integer ;
      c4v:column "0"^^xsd:integer ;
      c4v:row "1"^^xsd:integer ;
      dcterms:hasPart :web, :api, :worker, :postgres, :redis, :minio, :minio-init .
  :list:iat:noteList:1 rdf:first "Everything runs from one docker-compose.yml; there are no external systems. PostgreSQL, Redis and MinIO come from public images." ;
      rdf:rest :list:iat:noteList:2 .
  :list:iat:noteList:2 rdf:first "Theoretical example project: a documentation fixture that has never been executed." ;
      rdf:rest rdf:nil .
  :web a c4:Element, c4:Container ;
      rdfs:label "Web app" ;
      dcterms:identifier "web" ;
      dcterms:description "React single-page app built with Vite and served by nginx. The same nginx proxies /api/ to the API container, so the browser only ever talks to one origin for API calls." ;
      c4:summary "SPA · one page per role" ;
      c4:tag "CONTAINER · REACT + NGINX" ;
      c4:level "2"^^xsd:integer ;
      c4:note "Published on host port 3000 (container port 80).", "Images, thumbnails and export files are NOT proxied: the browser fetches them straight from MinIO through presigned URLs." ;
      c4v:noteList :list:web:noteList:1 ;
      c4:technology "TypeScript", "React 18", "react-router 6", "Vite", "nginx 1.27" ;
      c4v:technologyList :list:web:technologyList:1 ;
      c4:path "web/" ;
      dcterms:isPartOf :iat ;
      c4v:order "5"^^xsd:integer ;
      c4v:column "0"^^xsd:integer ;
      c4v:row "0"^^xsd:integer ;
      dcterms:hasPart :app, :annotate-page, :review-page, :admin-page, :canvas, :client, :nginx .
  :list:web:noteList:1 rdf:first "Published on host port 3000 (container port 80)." ;
      rdf:rest :list:web:noteList:2 .
  :list:web:noteList:2 rdf:first "Images, thumbnails and export files are NOT proxied: the browser fetches them straight from MinIO through presigned URLs." ;
      rdf:rest rdf:nil .
  :list:web:technologyList:1 rdf:first "TypeScript" ;
      rdf:rest :list:web:technologyList:2 .
  :list:web:technologyList:2 rdf:first "React 18" ;
      rdf:rest :list:web:technologyList:3 .
  :list:web:technologyList:3 rdf:first "react-router 6" ;
      rdf:rest :list:web:technologyList:4 .
  :list:web:technologyList:4 rdf:first "Vite" ;
      rdf:rest :list:web:technologyList:5 .
  :list:web:technologyList:5 rdf:first "nginx 1.27" ;
      rdf:rest rdf:nil .
  :api a c4:Element, c4:Container ;
      rdfs:label "API service" ;
      dcterms:identifier "api" ;
      dcterms:description "Owns all business rules: login, image upload, task claiming, annotations, review decisions and export requests. The only writer of task status." ;
      c4:summary "REST · auth · task rules" ;
      c4:tag "CONTAINER · FASTAPI" ;
      c4:level "2"^^xsd:integer ;
      c4:note "Entry point: api/app/main.py registers six routers and seeds one demo user per role on startup (lifespan).", "Published on host port 8000; OpenAPI docs at /docs. GET /api/health is the only route without auth besides login.", "Only enqueues background jobs, by dotted path, so it never imports worker code." ;
      c4v:noteList :list:api:noteList:1 ;
      c4:technology "Python 3.12", "FastAPI", "SQLAlchemy 2", "PyJWT", "boto3", "RQ" ;
      c4v:technologyList :list:api:technologyList:1 ;
      c4:path "api/" ;
      dcterms:isPartOf :iat ;
      c4v:order "6"^^xsd:integer ;
      c4v:style "highlight" ;
      c4v:column "1"^^xsd:integer ;
      c4v:row "0"^^xsd:integer ;
      dcterms:hasPart :auth, :images, :tasks, :annotations, :reviews, :export, :sm, :models, :storage, :queue, :lifecycle .
  :list:api:noteList:1 rdf:first "Entry point: api/app/main.py registers six routers and seeds one demo user per role on startup (lifespan)." ;
      rdf:rest :list:api:noteList:2 .
  :list:api:noteList:2 rdf:first "Published on host port 8000; OpenAPI docs at /docs. GET /api/health is the only route without auth besides login." ;
      rdf:rest :list:api:noteList:3 .
  :list:api:noteList:3 rdf:first "Only enqueues background jobs, by dotted path, so it never imports worker code." ;
      rdf:rest rdf:nil .
  :list:api:technologyList:1 rdf:first "Python 3.12" ;
      rdf:rest :list:api:technologyList:2 .
  :list:api:technologyList:2 rdf:first "FastAPI" ;
      rdf:rest :list:api:technologyList:3 .
  :list:api:technologyList:3 rdf:first "SQLAlchemy 2" ;
      rdf:rest :list:api:technologyList:4 .
  :list:api:technologyList:4 rdf:first "PyJWT" ;
