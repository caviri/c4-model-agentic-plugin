  :api a c4:Element, c4:Container ;
      rdfs:label "API service" ;
      dcterms:identifier "api" ;
      dcterms:description "Owns all business rules: login, image upload, task claiming, annotations, review decisions and export requests. The only writer of task status." ;
      c4:summary "REST · auth · task rules" ;
      c4:tag "CONTAINER · FASTAPI" ;
      c4:level "2"^^xsd:integer ;
      c4:note "Entry point: api/app/main.py registers six routers and seeds one demo user per role on startup (lifespan).", "Published on host port 8000; OpenAPI docs at /docs. GET /api/health is the only route without auth besides login.", "Only enqueues background jobs, by dotted path, so it never imports worker code." ;
      c4v:noteList :list:api:noteList:1 ;
