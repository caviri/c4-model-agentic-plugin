  :scenario:export a c4:Scenario ;
      rdfs:label "Export approved tasks (COCO)" ;
      dcterms:identifier "export" ;
      dcterms:description "An admin requests an export. The API only queues it; the worker builds the file and the page polls until a download URL appears." ;
      dcterms:isPartOf :model:image-annotation-tool ;
      c4:primaryActor :admin ;
      c4:goal "Download every approved annotation as one COCO-style JSON file." ;
      c4:trigger "The admin clicks \"Export approved annotations\" on the admin page." ;
      c4:precondition "Signed in with the admin role: POST /api/exports and GET /api/exports/{id} require it." ;
      c4:outcome "The worker writes exports/export-<id>.coco.json to MinIO and marks the export done with its task count; the page shows a presigned download URL." ;
      c4v:order "4"^^xsd:integer ;
      c4v:tone "teal" ;
      c4:hasStep :step:export:admin:admin-page, :step:export:admin-page:client, :step:export:client:request-export, :step:export:request-export:models, :step:export:request-export:enqueue-export, :step:export:enqueue-export:redis, :step:export:request-export:client, :step:export:redis:wmain, :step:export:wmain:export-approved, :step:export:export-approved:postgres, :step:export:export-approved:approved-boxes, :step:export:export-approved:postgres:2, :step:export:export-approved:build-coco, :step:export:export-approved:minio, :step:export:export-approved:postgres:3, :step:export:admin-page:client:2, :step:export:client:get-export, :step:export:get-export:export-to-dict, :step:export:export-to-dict:presigned-url, :step:export:get-export:client, :step:export:admin:admin-page:2, :step:export:admin-page:minio .
  :step:export:admin:admin-page a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "1"^^xsd:integer ;
      c4:source :admin ;
      c4:target :admin-page ;
      rdfs:label "Export approved annotations" .
  :step:export:admin-page:client a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "2"^^xsd:integer ;
      c4:source :admin-page ;
      c4:target :client ;
      rdfs:label "requestExport()" .
  :step:export:client:request-export a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "3"^^xsd:integer ;
      c4:source :client ;
      c4:target :request-export ;
      rdfs:label "POST /api/exports" .
  :step:export:request-export:models a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "4"^^xsd:integer ;
      c4:source :request-export ;
      c4:target :models ;
      rdfs:label "add Export(status=queued) · commit" .
  :step:export:request-export:enqueue-export a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "5"^^xsd:integer ;
      c4:source :request-export ;
      c4:target :enqueue-export ;
      rdfs:label "enqueue_export(export.id)" .
  :step:export:enqueue-export:redis a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "6"^^xsd:integer ;
      c4:source :enqueue-export ;
      c4:target :redis ;
      rdfs:label "enqueue export_approved (600 s)" .
  :step:export:request-export:client a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "7"^^xsd:integer ;
      c4:source :request-export ;
      c4:target :client ;
      rdfs:label "202 · status queued" ;
      c4:isReply "true"^^xsd:boolean .
  :step:export:redis:wmain a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "8"^^xsd:integer ;
      c4:source :redis ;
      c4:target :wmain ;
      rdfs:label "job from queue \"exports\"" .
  :step:export:wmain:export-approved a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "9"^^xsd:integer ;
      c4:source :wmain ;
      c4:target :export-approved ;
      rdfs:label "export_approved(export_id)" .
  :step:export:export-approved:postgres a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "10"^^xsd:integer ;
      c4:source :export-approved ;
      c4:target :postgres ;
      rdfs:label "UPDATE exports SET status = 'running'" .
  :step:export:export-approved:approved-boxes a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "11"^^xsd:integer ;
      c4:source :export-approved ;
      c4:target :approved-boxes ;
      rdfs:label "execute APPROVED_BOXES" .
  :step:export:export-approved:postgres:2 a c4:Step ;
      c4:inScenario :scenario:export ;
      schema:position "12"^^xsd:integer ;
      c4:source :export-approved ;
      c4:target :postgres ;
      rdfs:label "SELECT boxes WHERE status = 'approved'" .
  :step:export:export-approved:build-coco a c4:Step ;
