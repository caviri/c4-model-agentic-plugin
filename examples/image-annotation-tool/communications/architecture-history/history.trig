      c4:summary "SPA · one page per role" ;
      c4:tag "CONTAINER · REACT + NGINX" ;
      c4:level "2"^^xsd:integer ;
      c4:note "Published on host port 3000 (container port 80).", "Images, thumbnails and export files are NOT proxied: the browser fetches them straight from MinIO through presigned URLs." ;
