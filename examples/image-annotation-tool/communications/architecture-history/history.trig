  :annotator a c4:Element, c4:Person ;
      rdfs:label "Annotator" ;
      dcterms:identifier "annotator" ;
      dcterms:description "Claims a task, draws and labels bounding boxes on the image, submits it for review, and fixes rejected tasks." ;
      c4:summary "draws + labels boxes" ;
      c4:level "1"^^xsd:integer ;
      c4:path "README.md" ;
      c4:line "15"^^xsd:integer ;
      dcterms:isPartOf :model:image-annotation-tool ;
