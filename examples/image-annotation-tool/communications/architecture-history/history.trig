  :scenario:upload a c4:Scenario ;
      rdfs:label "Upload a batch + thumbnails" ;
      dcterms:identifier "upload" ;
      dcterms:description "An admin uploads images. The API stores them and creates one pending task per image; thumbnails are produced afterwards by the worker. All /api calls pass through the nginx proxy." ;
      dcterms:isPartOf :model:image-annotation-tool ;
      c4v:order "1"^^xsd:integer ;
      c4:hasStep :step:upload:admin:admin-page, :step:upload:admin-page:client, :step:upload:client:upload-batch, :step:upload:upload-batch:require-role, :step:upload:upload-batch:upload-image, :step:upload:upload-image:minio, :step:upload:upload-batch:models, :step:upload:models:postgres, :step:upload:upload-batch:enqueue-thumbnail, :step:upload:enqueue-thumbnail:redis, :step:upload:upload-batch:client, :step:upload:redis:wmain, :step:upload:wmain:thumb, :step:upload:thumb:postgres, :step:upload:thumb:minio, :step:upload:thumb:minio:2, :step:upload:thumb:postgres:2 .
