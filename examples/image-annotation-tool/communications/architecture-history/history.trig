GRAPH :version:1e415ac8413eb9e53fd1e596e04e3bb446097b15 {
  :model:image-annotation-tool a c4:Model ;
      dcterms:title "Image Annotation Tool architecture" ;
      rdfs:label "Image Annotation Tool" ;
      dcterms:description "Humans draw labelled bounding boxes on images; every task is reviewed before it can be exported as COCO JSON. Start at the API service, then open \"Task lifecycle\" to see the statuses a task moves through. The Dynamic tab walks through upload, annotate, review and export." ;
      dcterms:identifier "image-annotation-tool" ;
      dcterms:conformsTo <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4>, <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view> ;
      c4v:subtitle "examples/image-annotation-tool" ;
      c4v:toolbarTitle "Architecture map" ;
      c4v:startLevel "2"^^xsd:integer ;
      c4v:defaultPins :list:model:image-annotation-tool:defaultPins:1 ;
      dcterms:hasPart :admin, :annotator, :reviewer, :iat .
  :list:model:image-annotation-tool:defaultPins:1 rdf:first :annotator ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:2 .
  :list:model:image-annotation-tool:defaultPins:2 rdf:first :reviewer ;
      rdf:rest :list:model:image-annotation-tool:defaultPins:3 .
