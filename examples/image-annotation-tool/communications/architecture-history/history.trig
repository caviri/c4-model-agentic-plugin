  :scenario:annotate a c4:Scenario ;
      rdfs:label "Annotate + submit" ;
      dcterms:identifier "annotate" ;
      dcterms:description "An annotator claims the oldest pending task, draws boxes and submits it. Status: pending → in_progress → submitted." ;
      dcterms:isPartOf :model:image-annotation-tool ;
      c4:primaryActor :annotator ;
      c4:goal "Get the next image annotated with labelled boxes and handed over for review." ;
      c4:trigger "The annotator opens /annotate, which asks the API for the next task." ;
      c4:precondition "Signed in with the annotator role: POST /api/tasks/next and POST /api/tasks/{id}/submit require it.", "A task is pending, or the annotator already has one in progress; otherwise the API answers 404 \"no pending tasks\"." ;
      c4v:preconditionList :list:scenario:annotate:preconditionList:1 ;
      c4:outcome "The task is submitted with at least one box (an empty submit is refused with 422) and appears in the review queue." ;
      c4v:order "2"^^xsd:integer ;
      c4:hasStep :step:annotate:annotator:annotate-page, :step:annotate:annotate-page:client, :step:annotate:client:claim-next, :step:annotate:claim-next:models, :step:annotate:claim-next:apply-action, :step:annotate:apply-action:next-status, :step:annotate:claim-next:models:2, :step:annotate:claim-next:task-to-dict, :step:annotate:task-to-dict:image-to-dict, :step:annotate:image-to-dict:presigned-url, :step:annotate:claim-next:client, :step:annotate:annotate-page:canvas, :step:annotate:canvas:minio, :step:annotate:annotator:canvas, :step:annotate:annotator:annotate-page:2, :step:annotate:annotate-page:client:2, :step:annotate:client:annotations, :step:annotate:annotations:models, :step:annotate:annotate-page:client:3, :step:annotate:client:submit-task, :step:annotate:submit-task:apply-action, :step:annotate:apply-action:next-status:2, :step:annotate:submit-task:models, :step:annotate:models:postgres .
  :list:scenario:annotate:preconditionList:1 rdf:first "Signed in with the annotator role: POST /api/tasks/next and POST /api/tasks/{id}/submit require it." ;
      rdf:rest :list:scenario:annotate:preconditionList:2 .
  :list:scenario:annotate:preconditionList:2 rdf:first "A task is pending, or the annotator already has one in progress; otherwise the API answers 404 \"no pending tasks\"." ;
      rdf:rest rdf:nil .
