:models a c4:Element, c4:Component ;
    rdfs:label "ORM models + session" ;
    dcterms:identifier "models" ;
    dcterms:description "SQLAlchemy models User, Image, Task, Annotation, Review and Export, with the engine and the per-request session from api/app/db.py." ;
    c4:summary "SQLAlchemy · 6 tables" ;
    c4:level 3 ;
    c4:note "The schema itself is owned by db/migrations/001_init.sql; the models only map it.",
