:scenario:annotate a c4:Scenario ;
    rdfs:label "Annotate + submit" ;
    dcterms:identifier "annotate" ;
    dcterms:description "An annotator claims the oldest pending task, draws boxes and submits it. Status: pending → in_progress → submitted." ;
    dcterms:isPartOf :model:image-annotation-tool ;
    c4:primaryActor :annotator ;
    c4:goal "Get the next image annotated with labelled boxes and handed over for review." ;
    c4:trigger "The annotator opens /annotate, which asks the API for the next task." ;
    c4:precondition "Signed in with the annotator role: POST /api/tasks/next and POST /api/tasks/{id}/submit require it.",
        "A task is pending, or the annotator already has one in progress; otherwise the API answers 404 \"no pending tasks\"." ;
    c4v:preconditionList ( "Signed in with the annotator role: POST /api/tasks/next and POST /api/tasks/{id}/submit require it." "A task is pending, or the annotator already has one in progress; otherwise the API answers 404 \"no pending tasks\"." ) ;
    c4:outcome "The task is submitted with at least one box (an empty submit is refused with 422) and appears in the review queue." ;
    c4v:order 2 ;
    c4:hasStep :step:annotate:1, :step:annotate:2, :step:annotate:3, :step:annotate:4, :step:annotate:5,
        :step:annotate:6, :step:annotate:7, :step:annotate:8, :step:annotate:9, :step:annotate:10,
        :step:annotate:11, :step:annotate:12, :step:annotate:13, :step:annotate:14, :step:annotate:15,
        :step:annotate:16, :step:annotate:17, :step:annotate:18, :step:annotate:19, :step:annotate:20,
        :step:annotate:21, :step:annotate:22, :step:annotate:23, :step:annotate:24 .

