:review-page a c4:Element, c4:Component ;
    rdfs:label "ReviewQueuePage" ;
    dcterms:identifier "review-page" ;
    dcterms:description "Reviewer view: submitted tasks with thumbnails, the selected task read-only, and approve / reject buttons." ;
    c4:summary "queue · approve / reject" ;
