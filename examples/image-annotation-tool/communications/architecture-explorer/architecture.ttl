# Image Annotation Tool architecture · terms: https://caviri.github.io/c4-model-agentic-plugin/ontology/c4 , https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view
@prefix c4: <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4#> .
@prefix c4v: <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix : <urn:architecture:image-annotation-tool:> .

:model:image-annotation-tool a c4:Model ;
    dcterms:title "Image Annotation Tool architecture" ;
    rdfs:label "Image Annotation Tool" ;
    dcterms:description "Humans draw labelled bounding boxes on images; every task is reviewed before it can be exported as COCO JSON. Start at the API service, then open \"Task lifecycle\" to see the statuses a task moves through. The Dynamic tab walks through upload, annotate, review and export." ;
    dcterms:identifier "image-annotation-tool" ;
    dcterms:conformsTo <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4>,
        <https://caviri.github.io/c4-model-agentic-plugin/ontology/c4-view> ;
    c4v:subtitle "examples/image-annotation-tool" ;
    c4v:toolbarTitle "Architecture map" ;
    c4v:startLevel 2 ;
    c4v:defaultPins ( :annotator :reviewer :web :apply-action :next-status :queue :postgres :redis :worker :minio ) ;
    dcterms:hasPart :admin, :annotator, :reviewer, :iat .

:admin a c4:Element, c4:Person ;
    rdfs:label "Admin" ;
    dcterms:identifier "admin" ;
    dcterms:description "Uploads batches of images and triggers exports of approved annotations. Role \"admin\" in the users table." ;
    c4:summary "uploads batches · exports" ;
    c4:level 1 ;
    c4:path "README.md" ;
    c4:line 14 ;
    dcterms:isPartOf :model:image-annotation-tool ;
    c4v:order 1 ;
    c4v:column 2 ;
    c4v:row 0 ;
    c4:uses :admin-page .

:annotator a c4:Element, c4:Person ;
    rdfs:label "Annotator" ;
    dcterms:identifier "annotator" ;
    dcterms:description "Claims a task, draws and labels bounding boxes on the image, submits it for review, and fixes rejected tasks." ;
    c4:summary "draws + labels boxes" ;
    c4:level 1 ;
    c4:path "README.md" ;
    c4:line 15 ;
    dcterms:isPartOf :model:image-annotation-tool ;
    c4v:order 2 ;
    c4v:column 0 ;
    c4v:row 0 ;
    c4:uses :annotate-page .

:reviewer a c4:Element, c4:Person ;
    rdfs:label "Reviewer" ;
    dcterms:identifier "reviewer" ;
    dcterms:description "Works through the review queue and approves each submitted task or rejects it with a mandatory comment." ;
    c4:summary "approves or rejects" ;
    c4:level 1 ;
    c4:path "README.md" ;
    c4:line 16 ;
    dcterms:isPartOf :model:image-annotation-tool ;
    c4v:order 3 ;
    c4v:column 1 ;
    c4v:row 0 ;
    c4:uses :review-page .

:iat a c4:Element, c4:SoftwareSystem ;
    rdfs:label "Image Annotation Tool" ;
    dcterms:identifier "iat" ;
    dcterms:description "Bounding-box annotation with a review step. Each uploaded image gets exactly one task; only approved tasks are exported as COCO-style JSON." ;
    c4:summary "annotate · review · export" ;
    c4:level 1 ;
    c4:note "Everything runs from one docker-compose.yml; there are no external systems. PostgreSQL, Redis and MinIO come from public images.",
        "Theoretical example project: a documentation fixture that has never been executed." ;
    c4v:noteList ( "Everything runs from one docker-compose.yml; there are no external systems. PostgreSQL, Redis and MinIO come from public images." "Theoretical example project: a documentation fixture that has never been executed." ) ;
    c4:path "." ;
    dcterms:isPartOf :model:image-annotation-tool ;
    c4v:order 4 ;
    c4v:column 0 ;
    c4v:row 1 ;
    dcterms:hasPart :web, :api, :worker, :postgres, :redis, :minio, :minio-init .

:web a c4:Element, c4:Container ;
    rdfs:label "Web app" ;
    dcterms:identifier "web" ;
    dcterms:description "React single-page app built with Vite and served by nginx. The same nginx proxies /api/ to the API container, so the browser only ever talks to one origin for API calls." ;
    c4:summary "SPA · one page per role" ;
    c4:tag "CONTAINER · REACT + NGINX" ;
    c4:level 2 ;
    c4:note "Published on host port 3000 (container port 80).",
        "Images, thumbnails and export files are NOT proxied: the browser fetches them straight from MinIO through presigned URLs." ;
    c4v:noteList ( "Published on host port 3000 (container port 80)." "Images, thumbnails and export files are NOT proxied: the browser fetches them straight from MinIO through presigned URLs." ) ;
    c4:technology "TypeScript", "React 18", "react-router 6", "Vite", "nginx 1.27" ;
    c4v:technologyList ( "TypeScript" "React 18" "react-router 6" "Vite" "nginx 1.27" ) ;
    c4:path "web/" ;
    dcterms:isPartOf :iat ;
    c4v:order 5 ;
    c4v:column 0 ;
    c4v:row 0 ;
    dcterms:hasPart :app, :annotate-page, :review-page, :admin-page, :canvas, :client, :nginx .

:api a c4:Element, c4:Container ;
    rdfs:label "API service" ;
    dcterms:identifier "api" ;
    dcterms:description "Owns all business rules: login, image upload, task claiming, annotations, review decisions and export requests. The only writer of task status." ;
    c4:summary "REST · auth · task rules" ;
    c4:tag "CONTAINER · FASTAPI" ;
    c4:level 2 ;
    c4:note "Entry point: api/app/main.py registers six routers and seeds one demo user per role on startup (lifespan).",
        "Published on host port 8000; OpenAPI docs at /docs. GET /api/health is the only route without auth besides login.",
        "Only enqueues background jobs, by dotted path, so it never imports worker code." ;
    c4v:noteList ( "Entry point: api/app/main.py registers six routers and seeds one demo user per role on startup (lifespan)." "Published on host port 8000; OpenAPI docs at /docs. GET /api/health is the only route without auth besides login." "Only enqueues background jobs, by dotted path, so it never imports worker code." ) ;
    c4:technology "Python 3.12", "FastAPI", "SQLAlchemy 2", "PyJWT", "boto3", "RQ" ;
    c4v:technologyList ( "Python 3.12" "FastAPI" "SQLAlchemy 2" "PyJWT" "boto3" "RQ" ) ;
    c4:path "api/" ;
    dcterms:isPartOf :iat ;
    c4v:order 6 ;
    c4v:style "highlight" ;
    c4v:column 1 ;
    c4v:row 0 ;
    dcterms:hasPart :auth, :images, :tasks, :annotations, :reviews, :export, :sm, :models, :storage, :queue,
        :lifecycle .

:worker a c4:Element, c4:Container ;
    rdfs:label "Worker" ;
    dcterms:identifier "worker" ;
    dcterms:description "Background worker that consumes the \"thumbnails\" and \"exports\" queues from Redis and runs the matching job." ;
    c4:summary "thumbnails · COCO export" ;
    c4:tag "CONTAINER · RQ WORKER" ;
    c4:level 2 ;
    c4:note "Talks to PostgreSQL and MinIO directly through worker/clients.py; it never calls the API.",
        "No retry or failure queue is configured in the code." ;
    c4v:noteList ( "Talks to PostgreSQL and MinIO directly through worker/clients.py; it never calls the API." "No retry or failure queue is configured in the code." ) ;
    c4:technology "Python 3.12", "RQ", "Pillow", "SQLAlchemy Core", "boto3" ;
    c4v:technologyList ( "Python 3.12" "RQ" "Pillow" "SQLAlchemy Core" "boto3" ) ;
    c4:path "worker/" ;
    dcterms:isPartOf :iat ;
    c4v:order 7 ;
    c4v:column 1 ;
    c4v:row 2 ;
    dcterms:hasPart :wmain, :thumb, :coco .

:postgres a c4:Element, c4:Container, c4:DataStore ;
    rdfs:label "PostgreSQL" ;
    dcterms:identifier "postgres" ;
    dcterms:description "System of record: users, images, tasks, annotations, reviews and exports." ;
    c4:summary "users · tasks · boxes · reviews" ;
    c4:tag "DATA STORE · POSTGRES 16" ;
    c4:level 2 ;
    c4:note "Schema is created by mounting db/migrations into /docker-entrypoint-initdb.d; there is no migration tool.",
        "CHECK constraints repeat the allowed task statuses, review decisions and export statuses.",
        "tasks.image_id is UNIQUE: exactly one task per image." ;
    c4v:noteList ( "Schema is created by mounting db/migrations into /docker-entrypoint-initdb.d; there is no migration tool." "CHECK constraints repeat the allowed task statuses, review decisions and export statuses." "tasks.image_id is UNIQUE: exactly one task per image." ) ;
    c4:technology "PostgreSQL 16" ;
    c4:path "db/migrations/001_init.sql" ;
    dcterms:isPartOf :iat ;
    c4v:order 8 ;
    c4v:column 1 ;
    c4v:row 1 .

:redis a c4:Element, c4:Container, c4:DataStore ;
    rdfs:label "Redis" ;
    dcterms:identifier "redis" ;
    dcterms:description "Job queue between the API (producer) and the worker (consumer). Two RQ queues: \"thumbnails\" and \"exports\"." ;
    c4:summary "RQ queues: thumbnails · exports" ;
    c4:tag "QUEUE · REDIS 7" ;
    c4:level 2 ;
    c4:technology "Redis 7", "RQ" ;
    c4v:technologyList ( "Redis 7" "RQ" ) ;
    c4:path "docker-compose.yml" ;
    c4:line 46 ;
    dcterms:isPartOf :iat ;
    c4v:order 9 ;
    c4v:column 2 ;
    c4v:row 1 .

:minio a c4:Element, c4:Container, c4:DataStore ;
    rdfs:label "MinIO" ;
    dcterms:identifier "minio" ;
    dcterms:description "S3-compatible object storage with three buckets: original images, thumbnails and export files." ;
    c4:summary "images · thumbnails · exports" ;
    c4:tag "OBJECT STORE · S3 API" ;
    c4:level 2 ;
    c4:note "Internal endpoint S3_ENDPOINT (http://minio:9000) for uploads; S3_PUBLIC_ENDPOINT (http://localhost:9000) is what presigned URLs are signed against.",
        "Console on host port 9001." ;
    c4v:noteList ( "Internal endpoint S3_ENDPOINT (http://minio:9000) for uploads; S3_PUBLIC_ENDPOINT (http://localhost:9000) is what presigned URLs are signed against." "Console on host port 9001." ) ;
    c4:technology "MinIO", "S3 API" ;
    c4v:technologyList ( "MinIO" "S3 API" ) ;
    c4:path "docker-compose.yml" ;
    c4:line 51 ;
    dcterms:isPartOf :iat ;
    c4v:order 10 ;
