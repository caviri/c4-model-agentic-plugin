    c4v:row 1 .

:minio-init a c4:Element, c4:Container ;
    rdfs:label "minio-init" ;
    dcterms:identifier "minio-init" ;
    dcterms:description "One-shot container that creates the three buckets and exits. The API and the worker wait for it to complete successfully before starting." ;
    c4:summary "creates buckets · exits" ;
    c4:tag "ONE-SHOT JOB · MC" ;
    c4:level 2 ;
