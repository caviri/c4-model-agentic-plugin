:admin-page a c4:Element, c4:Component ;
    rdfs:label "AdminUploadPage" ;
    dcterms:identifier "admin-page" ;
    dcterms:description "Admin view: uploads a named batch of JPEG/PNG files and starts a COCO export, polling until the worker has finished." ;
    c4:summary "upload batch · export" ;
    c4:level 3 ;
    c4:note "Polls GET /exports/{id} every 2000 ms until status is done or failed.",
        "The download link is a presigned MinIO URL, so the file is fetched from MinIO directly (not drawn as an arrow)." ;
    c4v:noteList ( "Polls GET /exports/{id} every 2000 ms until status is done or failed." "The download link is a presigned MinIO URL, so the file is fetched from MinIO directly (not drawn as an arrow)." ) ;
