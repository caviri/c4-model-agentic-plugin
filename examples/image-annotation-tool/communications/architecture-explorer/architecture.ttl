:client a c4:Element, c4:Component ;
    rdfs:label "API client" ;
    dcterms:identifier "client" ;
    dcterms:description "Thin typed wrapper around fetch for every API call. Keeps the JWT and the role in localStorage and adds the Authorization header." ;
    c4:summary "fetch /api · bearer token" ;
    c4:level 3 ;
    c4:note "All calls go to the relative path /api, which nginx proxies to the API container.",
        "claimNextTask() turns any failure (including 404 \"no pending tasks\") into null." ;
    c4v:noteList ( "All calls go to the relative path /api, which nginx proxies to the API container." "claimNextTask() turns any failure (including 404 \"no pending tasks\") into null." ) ;
    c4:path "web/src/api/client.ts" ;
    dcterms:isPartOf :web ;
    c4v:order 17 ;
    c4v:column 1 ;
    c4v:row 1 ;
    c4:uses :login, :upload-batch, :claim-next, :list-tasks, :submit-task, :reopen-task, :annotations,
        :review-queue, :review-task, :request-export, :get-export .

