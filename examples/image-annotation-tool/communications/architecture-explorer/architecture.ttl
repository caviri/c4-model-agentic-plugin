:canvas a c4:Element, c4:Component ;
    rdfs:label "BoundingBoxCanvas" ;
    dcterms:identifier "canvas" ;
    dcterms:description "Shows an image with its boxes. In edit mode dragging draws a new box and double-click removes one; without onChange it is read-only (review)." ;
