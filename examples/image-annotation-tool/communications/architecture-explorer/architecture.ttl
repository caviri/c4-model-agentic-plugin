:scenario:export a c4:Scenario ;
    rdfs:label "Export approved tasks (COCO)" ;
    dcterms:identifier "export" ;
    dcterms:description "An admin requests an export. The API only queues it; the worker builds the file and the page polls until a download URL appears." ;
    dcterms:isPartOf :model:image-annotation-tool ;
    c4:primaryActor :admin ;
    c4:goal "Download every approved annotation as one COCO-style JSON file." ;
    c4:trigger "The admin clicks \"Export approved annotations\" on the admin page." ;
    c4:precondition "Signed in with the admin role: POST /api/exports and GET /api/exports/{id} require it." ;
    c4:outcome "The worker writes exports/export-<id>.coco.json to MinIO and marks the export done with its task count; the page shows a presigned download URL." ;
    c4v:order 4 ;
    c4:hasStep :step:export:1, :step:export:2, :step:export:3, :step:export:4, :step:export:5, :step:export:6,
        :step:export:7, :step:export:8, :step:export:9, :step:export:10, :step:export:11,
        :step:export:12, :step:export:13, :step:export:14, :step:export:15, :step:export:16,
        :step:export:17, :step:export:18, :step:export:19, :step:export:20, :step:export:21,
        :step:export:22 .

:step:export:1 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 1 ;
    c4:source :admin ;
    c4:target :admin-page ;
    rdfs:label "Export approved annotations" .

:step:export:2 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 2 ;
    c4:source :admin-page ;
    c4:target :client ;
    rdfs:label "requestExport()" .

:step:export:3 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 3 ;
    c4:source :client ;
    c4:target :request-export ;
    rdfs:label "POST /api/exports" .

:step:export:4 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 4 ;
    c4:source :request-export ;
    c4:target :models ;
    rdfs:label "add Export(status=queued) · commit" .

:step:export:5 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 5 ;
    c4:source :request-export ;
    c4:target :enqueue-export ;
    rdfs:label "enqueue_export(export.id)" .

:step:export:6 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 6 ;
    c4:source :enqueue-export ;
    c4:target :redis ;
    rdfs:label "enqueue export_approved (600 s)" .

:step:export:7 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 7 ;
    c4:source :request-export ;
    c4:target :client ;
    rdfs:label "202 · status queued" ;
    c4:isReply true .

:step:export:8 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 8 ;
    c4:source :redis ;
    c4:target :wmain ;
    rdfs:label "job from queue \"exports\"" .

:step:export:9 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 9 ;
    c4:source :wmain ;
    c4:target :export-approved ;
    rdfs:label "export_approved(export_id)" .

:step:export:10 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 10 ;
    c4:source :export-approved ;
    c4:target :postgres ;
    rdfs:label "UPDATE exports SET status = 'running'" .

:step:export:11 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 11 ;
    c4:source :export-approved ;
    c4:target :approved-boxes ;
    rdfs:label "execute APPROVED_BOXES" .

:step:export:12 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 12 ;
    c4:source :export-approved ;
    c4:target :postgres ;
    rdfs:label "SELECT boxes WHERE status = 'approved'" .

:step:export:13 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 13 ;
    c4:source :export-approved ;
    c4:target :build-coco ;
    rdfs:label "build_coco(rows)" .

:step:export:14 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 14 ;
    c4:source :export-approved ;
    c4:target :minio ;
    rdfs:label "PUT exports/export-<id>.coco.json" .

:step:export:15 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 15 ;
    c4:source :export-approved ;
    c4:target :postgres ;
    rdfs:label "UPDATE exports: done, key, task_count" .

:step:export:16 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 16 ;
    c4:source :admin-page ;
    c4:target :client ;
    rdfs:label "getExport(id) every 2 s" .

:step:export:17 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 17 ;
    c4:source :client ;
    c4:target :get-export ;
    rdfs:label "GET /api/exports/{id}" .

:step:export:18 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 18 ;
    c4:source :get-export ;
    c4:target :export-to-dict ;
    rdfs:label "export_to_dict(export)" .

:step:export:19 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 19 ;
    c4:source :export-to-dict ;
    c4:target :presigned-url ;
    rdfs:label "sign exports/<storage_key>" .

:step:export:20 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 20 ;
    c4:source :get-export ;
    c4:target :client ;
    rdfs:label "200 · done + download_url" ;
    c4:isReply true .

:step:export:21 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 21 ;
    c4:source :admin ;
    c4:target :admin-page ;
    rdfs:label "clicks Download COCO JSON" .

:step:export:22 a c4:Step ;
    c4:inScenario :scenario:export ;
    schema:position 22 ;
    c4:source :admin-page ;
    c4:target :minio ;
    rdfs:label "GET export file (presigned URL)" .
