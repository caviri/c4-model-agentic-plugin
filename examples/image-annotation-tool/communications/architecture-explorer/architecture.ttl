:app a c4:Element, c4:Component ;
    rdfs:label "App shell" ;
    dcterms:identifier "app" ;
    dcterms:description "Shows the login form until a role is known, then mounts exactly one route for that role and redirects everything else to it." ;
    c4:summary "login · route by role" ;
    c4:level 3 ;
    c4:note "Role comes from localStorage, set at login; the API enforces roles independently.",
        "Mounts AnnotatePage, ReviewQueuePage or AdminUploadPage at /annotate, /review or /admin. These render relationships are not drawn as arrows." ;
    c4v:noteList ( "Role comes from localStorage, set at login; the API enforces roles independently." "Mounts AnnotatePage, ReviewQueuePage or AdminUploadPage at /annotate, /review or /admin. These render relationships are not drawn as arrows." ) ;
