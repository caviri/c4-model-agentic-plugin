:scenario:upload a c4:Scenario ;
    rdfs:label "Upload a batch + thumbnails" ;
    dcterms:identifier "upload" ;
    dcterms:description "An admin uploads images. The API stores them and creates one pending task per image; thumbnails are produced afterwards by the worker. All /api calls pass through the nginx proxy." ;
    dcterms:isPartOf :model:image-annotation-tool ;
    c4v:order 1 ;
    c4:hasStep :step:upload:1, :step:upload:2, :step:upload:3, :step:upload:4, :step:upload:5, :step:upload:6,
        :step:upload:7, :step:upload:8, :step:upload:9, :step:upload:10, :step:upload:11,
        :step:upload:12, :step:upload:13, :step:upload:14, :step:upload:15, :step:upload:16,
        :step:upload:17 .

:step:upload:1 a c4:Step ;
    c4:inScenario :scenario:upload ;
    schema:position 1 ;
    c4:source :admin ;
    c4:target :admin-page ;
    rdfs:label "batch name + files, Upload" .

:step:upload:2 a c4:Step ;
    c4:inScenario :scenario:upload ;
    schema:position 2 ;
    c4:source :admin-page ;
    c4:target :client ;
    rdfs:label "uploadBatch(batchName, files)" .

