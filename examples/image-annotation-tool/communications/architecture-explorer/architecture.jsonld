      "@id": "urn:architecture:image-annotation-tool:api",
      "@type": [
        "c4:Element",
        "c4:Container"
      ],
      "name": "API service",
      "identifier": "api",
      "description": "Owns all business rules: login, image upload, task claiming, annotations, review decisions and export requests. The only writer of task status.",
      "summary": "REST · auth · task rules",
      "tag": "CONTAINER · FASTAPI",
      "level": 2,
      "note": [
        "Entry point: api/app/main.py registers six routers and seeds one demo user per role on startup (lifespan).",
        "Published on host port 8000; OpenAPI docs at /docs. GET /api/health is the only route without auth besides login.",
        "Only enqueues background jobs, by dotted path, so it never imports worker code."
      ],
      "noteList": [
        "Entry point: api/app/main.py registers six routers and seeds one demo user per role on startup (lifespan).",
