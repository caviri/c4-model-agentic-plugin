      "@id": "urn:architecture:image-annotation-tool:model:image-annotation-tool",
      "@type": "c4:Model",
      "title": "Image Annotation Tool architecture",
      "name": "Image Annotation Tool",
      "description": "Humans draw labelled bounding boxes on images; every task is reviewed before it can be exported as COCO JSON. Start at the API service, then open \"Task lifecycle\" to see the statuses a task moves through. The Dynamic tab walks through upload, annotate, review and export.",
      "identifier": "image-annotation-tool",
      "conformsTo": [
        "https://caviri.github.io/c4-model-agentic-plugin/ontology/c4",
