    {
      "@id": "urn:architecture:image-annotation-tool:scenario:annotate",
      "@type": "c4:Scenario",
      "name": "Annotate + submit",
      "identifier": "annotate",
      "description": "An annotator claims the oldest pending task, draws boxes and submits it. Status: pending → in_progress → submitted.",
      "isPartOf": "urn:architecture:image-annotation-tool:model:image-annotation-tool",
      "primaryActor": "urn:architecture:image-annotation-tool:annotator",
      "goal": "Get the next image annotated with labelled boxes and handed over for review.",
      "trigger": "The annotator opens /annotate, which asks the API for the next task.",
      "precondition": [
        "Signed in with the annotator role: POST /api/tasks/next and POST /api/tasks/{id}/submit require it.",
        "A task is pending, or the annotator already has one in progress; otherwise the API answers 404 \"no pending tasks\"."
      ],
      "preconditionList": [
        "Signed in with the annotator role: POST /api/tasks/next and POST /api/tasks/{id}/submit require it.",
        "A task is pending, or the annotator already has one in progress; otherwise the API answers 404 \"no pending tasks\"."
      ],
      "outcome": "The task is submitted with at least one box (an empty submit is refused with 422) and appears in the review queue.",
      "order": 2,
      "hasStep": [
        "urn:architecture:image-annotation-tool:step:annotate:1",
        "urn:architecture:image-annotation-tool:step:annotate:2",
        "urn:architecture:image-annotation-tool:step:annotate:3",
