    {
      "@id": "urn:architecture:image-annotation-tool:iat",
      "@type": [
        "arch:Element",
        "arch:SoftwareSystem"
      ],
      "name": "Image Annotation Tool",
      "identifier": "iat",
      "description": "Bounding-box annotation with a review step. Each uploaded image gets exactly one task; only approved tasks are exported as COCO-style JSON.",
      "summary": "annotate · review · export",
      "level": 1,
      "note": [
        "Everything runs from one docker-compose.yml; there are no external systems. PostgreSQL, Redis and MinIO come from public images.",
        "Theoretical example project: a documentation fixture that has never been executed."
      ],
      "path": ".",
      "isPartOf": "urn:architecture:image-annotation-tool:model:image-annotation-tool",
      "hasPart": [
        "urn:architecture:image-annotation-tool:web",
        "urn:architecture:image-annotation-tool:api",
        "urn:architecture:image-annotation-tool:worker",
        "urn:architecture:image-annotation-tool:postgres",
        "urn:architecture:image-annotation-tool:redis",
        "urn:architecture:image-annotation-tool:minio",
        "urn:architecture:image-annotation-tool:minio-init"
      ]
    },
    {
      "@id": "urn:architecture:image-annotation-tool:web",
      "@type": [
        "arch:Element",
        "arch:Container"
      ],
      "name": "Web app",
      "identifier": "web",
      "description": "React single-page app built with Vite and served by nginx. The same nginx proxies /api/ to the API container, so the browser only ever talks to one origin for API calls.",
      "summary": "SPA · one page per role",
      "tag": "CONTAINER · REACT + NGINX",
      "level": 2,
      "note": [
        "Published on host port 3000 (container port 80).",
        "Images, thumbnails and export files are NOT proxied: the browser fetches them straight from MinIO through presigned URLs."
      ],
      "technology": [
        "TypeScript",
        "React 18",
        "react-router 6",
        "Vite",
        "nginx 1.27"
      ],
      "path": "web/",
      "isPartOf": "urn:architecture:image-annotation-tool:iat",
      "hasPart": [
