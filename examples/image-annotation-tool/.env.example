# PostgreSQL
POSTGRES_USER=annotation
POSTGRES_PASSWORD=annotation
POSTGRES_DB=annotation
DATABASE_URL=postgresql+psycopg://annotation:annotation@postgres:5432/annotation

# Redis (job queue between api and worker)
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
# Endpoint the browser uses for presigned URLs
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_IMAGES=images
S3_BUCKET_THUMBNAILS=thumbnails
S3_BUCKET_EXPORTS=exports

# API auth
JWT_SECRET=change-me
JWT_TTL_MINUTES=480
