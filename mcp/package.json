{
  "name": "c4-explorer-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server with an MCP Apps widget: build C4 architecture models as RDF in a chat (ChatGPT, Claude) and explore them inline.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "server.mjs",
  "bin": { "c4-explorer-mcp": "server.mjs" },
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.mjs",
    "stdio": "node server.mjs --stdio",
    "widget": "node scripts/write-widget.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "rete-graph": "0.7.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "puppeteer-core": "24.31.0"
  }
}
